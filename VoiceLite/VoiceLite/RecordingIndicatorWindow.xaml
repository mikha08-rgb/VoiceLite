<!-- The recording pill. Deliberately self-contained: every brush is inline - no resource keys, no
     merged dictionaries, no styles from anywhere else (a missing shared style key was the v2.5.0
     outage). Size, position and all motion come from the code-behind / RecordingIndicatorLogic.
     It must never take focus: text is pasted into whatever window the user is dictating into. -->
<Window x:Class="VoiceLite.RecordingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceLite recording indicator"
        Width="152" Height="66"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsTabStop="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Margin = RecordingIndicatorLogic.ShadowPadding: transparent room for the shadow and the slide-in. -->
    <Grid x:Name="Root" Margin="16" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="6"/>
        </Grid.RenderTransform>

        <!-- Fill + shadow on their own element: the bars change every frame, and an effect on
             their parent would be re-rendered every frame with them. -->
        <Border CornerRadius="17" Background="#E6141416">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="Black" Opacity="0.32"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="17" BorderBrush="#22FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Status dot: red while recording, soft amber while transcribing (cross-faded in code). -->
                <Grid Width="20" Height="20" VerticalAlignment="Center">
                    <Ellipse x:Name="RecordingGlow" Opacity="0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#B3FF453A" Offset="0"/>
                                <GradientStop Color="#59FF453A" Offset="0.45"/>
                                <GradientStop Color="#00FF453A" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="ProcessingGlow" Opacity="0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#80F2BC5E" Offset="0"/>
                                <GradientStop Color="#33F2BC5E" Offset="0.45"/>
                                <GradientStop Color="#00F2BC5E" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="RecordingDot" Width="8" Height="8" Fill="#FF453A"/>
                    <Ellipse x:Name="ProcessingDot" Width="8" Height="8" Fill="#F2BC5E" Opacity="0"/>
                </Grid>

                <!-- Level meter. Heights are set every frame; no layout rounding here, or the
                     vertically centred bars would jitter by a pixel as they grow. -->
                <StackPanel x:Name="Bars" Orientation="Horizontal" Height="18" Margin="5,0,4,0"
                            VerticalAlignment="Center" UseLayoutRounding="False" SnapsToDevicePixels="False">
                    <Rectangle Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="#F2FFFFFF"/>
                    <Rectangle Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="#F2FFFFFF"/>
                    <Rectangle Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="#F2FFFFFF"/>
                    <Rectangle Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="#F2FFFFFF"/>
                    <Rectangle Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="#F2FFFFFF"/>
                    <Rectangle Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="#F2FFFFFF"/>
                    <Rectangle Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="#F2FFFFFF"/>
                    <Rectangle Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="#F2FFFFFF"/>
                    <Rectangle Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1.5,0" VerticalAlignment="Center" Fill="#F2FFFFFF"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

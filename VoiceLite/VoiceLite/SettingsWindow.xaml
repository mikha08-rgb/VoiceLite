<Window x:Class="VoiceLite.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceLite Settings"
        Width="780" Height="560"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#4169E1"/>
        <SolidColorBrush x:Key="TextBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7A7A7A"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#D32F2F"/>
        <SolidColorBrush x:Key="OkBrush" Color="#27AE60"/>

        <!-- Left navigation -->
        <Style x:Key="NavTab" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="12,8" Margin="0,0,10,3" CornerRadius="6" Background="Transparent" Cursor="Hand">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Header}" Foreground="#5A5A5A"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDEFF2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Alert" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#CFCFCF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3451B2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Name="SettingsTabs"
                    Grid.Row="0"
                    TabStripPlacement="Left"
                    Margin="16,16,16,0"
                    Padding="0"
                    Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource NavTab}"/>
            </TabControl.Resources>

            <!-- ================= Hotkey & mode ================= -->
            <TabItem Header="Hotkey &amp; mode" Name="HotkeyTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Hotkey &amp; mode" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Record hotkey" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Name="HotkeyBox"
                                     Width="220" Height="34"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     FontSize="14"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="#F3F4F6"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyBox_GotFocus"
                                     LostKeyboardFocus="HotkeyBox_LostFocus"/>
                            <TextBlock Name="HotkeyCaptureHint"
                                       Text="Press the keys you want. Esc keeps the current hotkey."
                                       Style="{StaticResource Hint}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock Text="Click the box, then press a key combination. A single key such as Left Ctrl or CapsLock works too."
                                   Style="{StaticResource Hint}"/>
                        <TextBlock Name="HotkeyErrorText"
                                   Text="That key is already taken by another app. Pick a different one."
                                   Style="{StaticResource Alert}"/>

                        <TextBlock Text="Recording mode" Style="{StaticResource Label}"/>
                        <RadioButton Name="ToggleRadio" GroupName="Mode" Content="Toggle — press once to start, press again to stop" IsChecked="True"/>
                        <RadioButton Name="PushToTalkRadio" GroupName="Mode" Content="Push-to-talk — hold the key while you speak"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Microphone ================= -->
            <TabItem Header="Microphone">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Microphone" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Input device" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Name="MicrophoneComboBox"
                                      Width="340" Height="30"
                                      DisplayMemberPath="Name"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="MicrophoneComboBox_SelectionChanged"/>
                            <Button Name="RefreshMicrophonesButton" Content="Refresh" Style="{StaticResource FlatButton}"
                                    Margin="8,0,0,0" Click="RefreshMicrophonesButton_Click"/>
                        </StackPanel>

                        <TextBlock Text="Input level" Style="{StaticResource Label}"/>
                        <Border Name="LevelTrack" Width="340" Height="8" HorizontalAlignment="Left"
                                Background="#E6E8EB" CornerRadius="4" ClipToBounds="True">
                            <Border Name="LevelBar" Width="0" HorizontalAlignment="Left"
                                    Background="{StaticResource OkBrush}" CornerRadius="4"/>
                        </Border>
                        <TextBlock Text="Say something — the bar should move." Style="{StaticResource Hint}"/>
                        <TextBlock Name="MicStatusText" Style="{StaticResource Alert}"/>

                        <TextBlock Text="Audio processing" Style="{StaticResource Label}"/>
                        <CheckBox Name="EnableVADCheckBox" Content="Trim silence before transcribing (voice activity detection)" IsChecked="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Transcription ================= -->
            <TabItem Header="Transcription">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Transcription" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Quality" Style="{StaticResource Label}" Margin="0,0,0,0"/>
                        <RadioButton Name="PresetSpeedRadio" GroupName="Preset" Content="Speed — fastest, fine for short notes and commands"/>
                        <RadioButton Name="PresetBalancedRadio" GroupName="Preset" Content="Balanced — recommended" IsChecked="True"/>
                        <RadioButton Name="PresetAccuracyRadio" GroupName="Preset" Content="Accuracy — best quality, slightly slower"/>
                        <TextBlock Text="Applies from your next recording." Style="{StaticResource Hint}"/>

                        <StackPanel Name="TranslationPanel">
                            <TextBlock Text="Translate to English (Pro)" Style="{StaticResource Label}"/>
                            <CheckBox Name="TranslateToEnglishCheckBox"
                                      Content="Translate my speech to English"
                                      Checked="TranslateToEnglishCheckBox_Changed"
                                      Unchecked="TranslateToEnglishCheckBox_Changed"/>
                            <StackPanel Name="TranslationOptionsPanel" Orientation="Horizontal" Margin="22,8,0,0" IsEnabled="False">
                                <TextBlock Text="Spoken language" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Name="TranslationSourceLanguageComboBox" Width="140" Height="28" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Spanish" Tag="es" IsSelected="True"/>
                                    <ComboBoxItem Content="French" Tag="fr"/>
                                    <ComboBoxItem Content="German" Tag="de"/>
                                </ComboBox>
                                <Button Name="InstallTranslationModelButton" Content="Install translation model"
                                        Style="{StaticResource FlatButton}" Margin="12,0,8,0"
                                        Click="InstallTranslationModelButton_Click"/>
                                <TextBlock Name="TranslationModelStatusText" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="Runs on this computer with a separate ~154 MB model. VoiceLite types the English translation instead of the original transcript."
                                       Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Text output ================= -->
            <TabItem Header="Text output">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Text output" Style="{StaticResource SectionTitle}"/>

                        <CheckBox Name="AutoPasteCheckBox" Content="Paste into the active app automatically" IsChecked="True" Margin="0"/>
                        <TextBlock Text="When off, the text is only copied to the clipboard." Style="{StaticResource Hint}" Margin="22,4,0,0"/>

                        <TextBlock Text="Text shortcuts" Style="{StaticResource Label}"/>
                        <TextBlock Text="Say a trigger phrase and VoiceLite types the replacement instead. Example: “my email” → john@example.com"
                                   Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                        <ListView Name="ShortcutsListView"
                                  Height="190"
                                  SelectionMode="Single"
                                  BorderBrush="{StaticResource LineBrush}"
                                  SelectionChanged="ShortcutsListView_SelectionChanged"
                                  MouseDoubleClick="ShortcutsListView_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Trigger" Width="160" DisplayMemberBinding="{Binding Trigger}"/>
                                    <GridViewColumn Header="Replacement" Width="300" DisplayMemberBinding="{Binding Replacement}"/>
                                    <GridViewColumn Header="On" Width="50">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsEnabled}" IsHitTestVisible="False" Margin="0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Name="AddShortcutButton" Content="Add" Style="{StaticResource FlatButton}" Click="AddShortcutButton_Click"/>
                            <Button Name="EditShortcutButton" Content="Edit" Style="{StaticResource FlatButton}" Margin="8,0,0,0" IsEnabled="False" Click="EditShortcutButton_Click"/>
                            <Button Name="DeleteShortcutButton" Content="Delete" Style="{StaticResource FlatButton}" Margin="8,0,0,0" IsEnabled="False" Click="DeleteShortcutButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Custom dictionary (Pro) ================= -->
            <TabItem Header="Dictionary" Name="CustomDictionaryTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Custom dictionary" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Spoken phrase → written form, applied to every transcription after VoiceLite's built-in dictionary, so your entries win. Examples: medicare → Medicare, egfr → eGFR."
                                   Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                        <DataGrid Name="CustomDictionaryGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEEEEE"
                                  Background="White"
                                  BorderBrush="{StaticResource LineBrush}"
                                  BorderThickness="1"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFAFA"
                                  MinHeight="180" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Spoken phrase" Binding="{Binding Spoken, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Written form" Binding="{Binding Written, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Name="RemoveDictionaryEntryButton" Content="Remove selected" Style="{StaticResource FlatButton}" Click="RemoveDictionaryEntryButton_Click"/>
                            <TextBlock Name="DictionaryEntryCountText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Account ================= -->
            <TabItem Header="Account">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Account" Style="{StaticResource SectionTitle}"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Plan:" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Name="LicenseTierText" Text="Free" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Name="LicenseDescriptionText"
                                   Text="Pro unlocks the custom dictionary and speech translation. Your license covers up to 3 computers."
                                   Style="{StaticResource Hint}"/>

                        <TextBlock Text="License key" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Name="LicenseKeyInput" Width="340" Height="30" FontFamily="Consolas" FontSize="13"
                                     VerticalContentAlignment="Center" Padding="6,0"/>
                            <Button Name="ActivateLicenseButton" Content="Activate" Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0" Click="ActivateLicenseButton_Click"/>
                        </StackPanel>
                        <TextBlock Name="LicenseStatusText" Style="{StaticResource Hint}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0">
                            <Run Text="Don't have a key? "/>
                            <Hyperlink NavigateUri="https://voicelite.app/#pricing" RequestNavigate="OpenExternalLink">See pricing at voicelite.app</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= About & updates ================= -->
            <TabItem Header="About &amp; updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="About &amp; updates" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Foreground="{StaticResource TextBrush}">
                            <Run Text="VoiceLite" FontWeight="SemiBold"/>
                            <Run Name="AboutVersionText" Text=""/>
                        </TextBlock>
                        <TextBlock Text="Speech engine: Sherpa-ONNX + NVIDIA Parakeet TDT 0.6B v3, running entirely on this computer."
                                   Style="{StaticResource Hint}"/>
                        <TextBlock Style="{StaticResource Hint}">
                            <Hyperlink NavigateUri="https://voicelite.app" RequestNavigate="OpenExternalLink">voicelite.app</Hyperlink>
                            <Run Text="  ·  "/>
                            <Hyperlink NavigateUri="https://github.com/mikha08-rgb/VoiceLite" RequestNavigate="OpenExternalLink">Source on GitHub</Hyperlink>
                        </TextBlock>

                        <TextBlock Text="Startup &amp; window" Style="{StaticResource Label}"/>
                        <CheckBox Name="CheckForUpdatesCheckBox" Content="Check for updates when VoiceLite starts" IsChecked="True" Margin="0"/>
                        <CheckBox Name="MinimizeToTrayCheckBox" Content="Keep running in the tray when the window is closed" IsChecked="True"/>
                        <CheckBox Name="ShowRecordingIndicatorCheckBox" Content="Show recording indicator while dictating" IsChecked="True"/>

                        <TextBlock Text="Third-party notices" Style="{StaticResource Label}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0">
                            <Run Text="Uses the NVIDIA Parakeet TDT 0.6B v3 model, © NVIDIA Corporation, unmodified under the "/>
                            <Hyperlink NavigateUri="https://creativecommons.org/licenses/by/4.0/" RequestNavigate="OpenExternalLink">CC-BY-4.0</Hyperlink>
                            <Run Text=" license ("/>
                            <Hyperlink NavigateUri="https://huggingface.co/nvidia/parakeet-tdt-0.6b-v3" RequestNavigate="OpenExternalLink">model card</Hyperlink>
                            <Run Text="). Other components: Sherpa-ONNX (Apache 2.0), ONNX Runtime (MIT), Silero VAD (MIT), NAudio (MIT), SharpCompress (MIT), Polly (BSD-3-Clause), Hardcodet.NotifyIcon.Wpf (CPOL), System.Text.Json (MIT), System.Management (MIT)."/>
                        </TextBlock>
                        <Button Name="OpenLicensesFolderButton" Content="Open LICENSES folder" Style="{StaticResource FlatButton}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenLicensesFolderButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Grid Grid.Row="1" Margin="16,12,16,14">
            <TextBlock Name="StatusText" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="CancelButton" Content="Cancel" Style="{StaticResource FlatButton}" IsCancel="True" Click="CancelButton_Click"/>
                <Button Name="ApplyButton" Content="Apply" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="ApplyButton_Click"/>
                <Button Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
